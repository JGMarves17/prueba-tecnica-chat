{
  "name": "chat-saas",
  "version": "1.0.0",
  "description": "Chat SaaS - Backend (Hono + Neon) + Frontend (Next.js + React Query + Tailwind)",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "test:backend": "npm --prefix backend test",
    "db:push": "npm --prefix backend run db:push",
    "db:seed": "npm --prefix backend run db:seed",
    "deploy:backend": "npm --prefix backend run deploy"
  },
  "keywords": ["chat", "saas", "hono", "nextjs", "react-query", "tailwind"],
  "author": "",
  "license": "MIT"
}
