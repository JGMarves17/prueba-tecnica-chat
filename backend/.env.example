# Variables de entorno para scripts de Node (drizzle-kit y seed)
# Copiar a .env y completar valores:  cp .env.example .env
#
# Lo usan:  npm run db:push  /  npm run db:generate  /  npm run db:seed

# ============================================
# CONEXIÓN A NEON POSTGRES
# ============================================
# Obtener en console.neon.tech → Project → Connection string
# Formato: postgresql://usuario:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://usuario:password@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require

# ============================================
# IMPORTANTE: WRANGLER DEV NO LEE ESTE ARCHIVO
# ============================================
# El Worker recibe sus variables por binding (c.env), NO por process.env.
# Para desarrollo local del Worker hay que crear ADEMÁS un .dev.vars:
#   cp .dev.vars.example .dev.vars
# Y poner el MISMO DATABASE_URL ahí.
